# Server
PORT=3001
PUBLIC_ORIGIN=https://your-domain.example.com
NODE_ENV=development

# Discord OAuth2 (Developer Portal > OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The client fetches DISCORD_CLIENT_ID from GET /api/config at runtime -- no separate
# VITE_ build-time copy needed, so rotating this only takes a server restart.

# Optional: only needed if server-side voice-channel membership verification is enabled
DISCORD_BOT_TOKEN=

# Discord user ids allowed to end anyone's broadcast, comma-separated. Leave empty and
# everyone can only stop their own. Enable Developer Mode in Discord, then right-click a
# user > "Copy User ID".
ADMIN_USER_IDS=

# Relay tuning
TARGET_VIDEO_BITRATE_KBPS=6000
MAX_CONCURRENT_ROOMS=2
MAX_VIEWERS_PER_ROOM=10

# Hosting from home without the Cloudflare Tunnel (start-bot.bat). "direto" runs Caddy
# instead of cloudflared (Caddyfile.home) on the port in PUBLIC_ORIGIN -- set it to
# https://share.iagofreire.dev:8443, the port the desktop app tries first. Forward that
# port on the router to this PC and allow caddy.exe through the Windows firewall. Caddy
# needs the Cloudflare DNS plugin: caddy add-package github.com/caddy-dns/cloudflare.
# Needs a public IPv4 (not CGNAT).
# Leave empty (or "tunel") to keep using the tunnel.
BOT_EXPOSE=
# For "direto": keeps PUBLIC_ORIGIN's hostname pointing at the home IP (DNS only, grey
# cloud), replacing the tunnel's CNAME on the first run. Token: Cloudflare dashboard >
# My Profile > API Tokens > "Edit zone DNS" template, limited to this zone. Zone ID: the
# domain's Overview page. To go back to the tunnel: BOT_EXPOSE=tunel, then
# cloudflared tunnel route dns --overwrite-dns screenshare-bot <hostname>
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
