# Server
PORT=3001
PUBLIC_ORIGIN=https://your-domain.example.com
NODE_ENV=development

# Discord OAuth2 (Developer Portal > OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The client fetches DISCORD_CLIENT_ID from GET /api/config at runtime -- no separate
# VITE_ build-time copy needed, so rotating this only takes a server restart.

# Optional: only needed if server-side voice-channel membership verification is enabled
DISCORD_BOT_TOKEN=

# Discord user ids allowed to end anyone's broadcast, comma-separated. Leave empty and
# everyone can only stop their own. Enable Developer Mode in Discord, then right-click a
# user > "Copy User ID".
ADMIN_USER_IDS=

# Relay tuning
TARGET_VIDEO_BITRATE_KBPS=6000
MAX_CONCURRENT_ROOMS=2
MAX_VIEWERS_PER_ROOM=10

# Optional TURN server, handed to clients by GET /api/ice.
#
# Viewers try a direct connection to the presenter on top of the relay; when it works,
# their video stops passing through this server entirely (less egress, and quality that
# degrades instead of falling behind). Public STUN is the built-in default and covers
# most home networks. TURN covers the rest -- symmetric NAT, CGNAT -- but it forwards
# the video itself, so it costs real bandwidth wherever it is hosted. Leave empty and
# anyone STUN cannot help simply stays on the WebSocket relay, exactly as before.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
