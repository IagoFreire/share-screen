# Server
PORT=3001
PUBLIC_ORIGIN=https://your-domain.example.com
NODE_ENV=development

# Discord OAuth2 (Developer Portal > OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The client fetches DISCORD_CLIENT_ID from GET /api/config at runtime -- no separate
# VITE_ build-time copy needed, so rotating this only takes a server restart.

# Optional: only needed if server-side voice-channel membership verification is enabled
DISCORD_BOT_TOKEN=

# Discord user ids allowed to end anyone's broadcast, comma-separated. Leave empty and
# everyone can only stop their own. Enable Developer Mode in Discord, then right-click a
# user > "Copy User ID".
ADMIN_USER_IDS=

# Relay tuning
TARGET_VIDEO_BITRATE_KBPS=6000
MAX_CONCURRENT_ROOMS=2
MAX_VIEWERS_PER_ROOM=10
