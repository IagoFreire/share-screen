{
  "name": "@screenshare-bot/desktop",
  "productName": "Janja",
  "version": "0.4.0",
  "private": true,
  "description": "Janja: lives de tela no Discord, app para Windows",
  "author": "Iago Freire",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node scripts/start.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icon": "node scripts/make-icon.cjs",
    "dist": "npm run build && npm run icon && npm run audio-helper && electron-builder --win nsis --publish never",
    "audio-helper": "node scripts/build-audio-helper.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@screenshare-bot/shared": "*",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.iagofreire.screenshare",
    "productName": "Janja",
    "electronVersion": "44.9.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "static/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Janja",
      "artifactName": "Janja-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "IagoFreire",
      "repo": "share-screen",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "native/audio-helper/target/release/audio-helper.exe",
        "to": "audio-helper.exe"
      }
    ]
  }
}
